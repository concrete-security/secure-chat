+    def _extract_harmony_tool_calls_streaming_fallback(
+        self,
+        request: ChatCompletionRequest,
+        tokenizer: TokenizerLike,
+        token_ids: GenericSequence[int],
+    ) -> list[DeltaToolCall]:
+        if not request.tools or self.tool_parser is None:
+            return []
+
+        try:
+            tool_parser = self.tool_parser(tokenizer)
+            tool_call_info = tool_parser.extract_tool_calls(
+                "",
+                request=request,
+                token_ids=token_ids,
+            )
+        except Exception:
+            logger.exception("Error extracting harmony tool calls at finish.")
+            return []
+
+        if not tool_call_info.tools_called:
+            return []
+
+        return [
+            DeltaToolCall(
+                id=tool_call.id,
+                type=tool_call.type,
+                index=index,
+                function=DeltaFunctionCall(
+                    name=tool_call.function.name,
+                    arguments=tool_call.function.arguments,
+                ),
+            )
+            for index, tool_call in enumerate(tool_call_info.tool_calls)
+        ]
